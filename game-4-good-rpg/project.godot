; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game4GoodRPG"
run/main_scene="uid://dduravpke4tpl"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Sprites/icon.svg"

[audio]

buses/default_bus_layout="uid://cjms8lnubsn5m"

[autoload]

global="*uid://drpslnkubvagw"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
QuestState="*res://Scripts/quest_state.gd"
AchievementManager="*res://Scripts/AchievementManager.gd"
SaveManager="*res://Scripts/SaveManager/Savemanager.gd"
FadeTransition="*res://Scenes/Transitions/Fade Transition.tscn"
UiSounds="*res://Scripts/ui_sounds.gd"
QuestMarkerManager="*res://Scripts/QuestMarkerManager.gd"
QuestLogUI="*res://Scripts/QuestLogUI.gd"
InventoryManager="*res://Scripts/InventoryManager.gd"
Inventory="*res://Scenes/ui/Inventory/Inventory.tscn"
DialogueChoices="*res://Scripts/DialogueChoiceTracker.gd"
ChapterSkipController="*res://Scripts/chapter_skip_controller.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

